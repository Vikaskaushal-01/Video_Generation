# Which AI to use: huggingface (free) | zhipu (free) | gemini (paid)
VIDEO_PROVIDER=huggingface

# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=paste-your-token-here

# Free key: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=paste-your-key-here

# Google key (only used when VIDEO_PROVIDER=gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here


# Free static ngrok domain (https://dashboard.ngrok.com/domains) — used by "npm run start:public"
NGROK_DOMAIN=your-name.ngrok-free.app
